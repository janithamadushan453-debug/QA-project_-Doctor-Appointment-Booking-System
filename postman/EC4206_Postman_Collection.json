            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"startAt\": \"{{slotStartAt}}\",\n  \"reason\": \"Specialist neurological consultation (automated QA check)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Appointment booked successfully (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Booking payload enforces booked status and 30-minute duration\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.eql(\"Appointment booked successfully\");",
                  "    pm.expect(res.appointment.status).to.eql(\"booked\");",
                  "    const startMs = new Date(res.appointment.startAt).getTime();",
                  "    const endMs   = new Date(res.appointment.endAt).getTime();",
                  "    pm.expect(endMs - startMs).to.eql(30 * 60 * 1000);",
                  "    pm.environment.set(\"appointmentId\", res.appointment._id);",
                  "});"
                ]
              }
            }
          ]
