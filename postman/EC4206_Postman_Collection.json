        {
          "name": "API-16A: POST /api/doctors/:id/slots — Publish Primary 30-Min Slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{createdDoctorId}}/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "doctors",
                "{{createdDoctorId}}",
                "slots"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startAt\": \"{{slotStartAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const offsetMinutes = Math.floor(Math.random() * 5000) + 120;",
                  "const slot1 = new Date(Date.now() + offsetMinutes * 60 * 1000);",
                  "slot1.setUTCSeconds(0, 0);",
                  "const slot2 = new Date(slot1.getTime() + 60 * 60 * 1000);",
                  "pm.environment.set(\"slotStartAt\", slot1.toISOString());",
                  "pm.environment.set(\"rescheduleSlotStartAt\", slot2.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Primary 30-minute slot published (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Confirmation message matches API contract\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.eql(\"30-minute slot added\");",
                  "});"
                ]
              }
            }
          ]
        },
